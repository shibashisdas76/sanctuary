# ==============================================================================
# Environment Configuration for The Sanctuary (Render Production Deployment)
# ==============================================================================

# PORT: Server port (Automatically provided by Render at runtime)
PORT=3000

# NODE_ENV: Application environment (Set to 'production' on Render)
NODE_ENV=production

# GEMINI_API_KEY: (Optional) API key for Gemini AI integrations
GEMINI_API_KEY=your_gemini_api_key_here

# APP_URL: Production domain URL on Render
APP_URL=https://the-sanctuary.onrender.com
